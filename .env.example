# Example environment configuration for Oda-Music

# Telegram API credentials
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Bot owner / admin
OWNER_ID=123456789

# Optional: Pyrogram string session (if using userbot features)
STRING_SESSION=your_string_session_here

# Database URL (if needed, else leave blank for sqlite)
DATABASE_URL=sqlite:///data/database.sqlite3

# Logging level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
